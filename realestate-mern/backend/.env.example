PORT=
MONGO_URI=
JWT_SECRET=
VITE_API_URL=

# Allowed frontend origin for REST CORS and the Socket.IO handshake
# (server.js + realtime/io.js use CLIENT_ORIGIN || CLIENT_URL).
# Dev: http://localhost:5173. Production (Render): the Vercel frontend URL.
CLIENT_ORIGIN=
# Fallback when CLIENT_ORIGIN is unset.
CLIENT_URL=

BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Direct-upload infrastructure (Phase 1). Signature window vs record TTL are
# different lifetimes — do not confuse them.
# Kill-switch for new sign/session issuance (complete/delete keep draining).
UPLOAD_DIRECT_ENABLED=
# Minutes a signed upload authorization stays valid.
UPLOAD_SIGNATURE_TTL_MINUTES=
# Hours an uncommitted upload record lives before the sweeper destroys it.
UPLOAD_RESOURCE_TTL_HOURS=
# Same, for hero video uploads (large files + review need longer).
UPLOAD_VIDEO_RESOURCE_TTL_HOURS=
# Sign rate limits (per user): general hourly cap...
UPLOAD_SIGN_RATE_LIMIT_PER_HOUR=
# ...and stricter daily cap for verification documents.
UPLOAD_VERIFICATION_SIGN_RATE_LIMIT_PER_DAY=
# Nightly upload-orphan sweeper (04:00) - set to 'false' to skip just this job.
UPLOAD_CLEANUP_ENABLED=
# Phase 2: property cover/gallery direct upload. 'false' forces the legacy
# multer path (direct uploadIds are rejected with 400); legacy req.files
# handling always stays available.
PROPERTY_DIRECT_UPLOAD_ENABLED=
# Phase 3: hero media/thumbnail direct upload. Same contract as above.
HERO_DIRECT_UPLOAD_ENABLED=
# Phase 4: blog cover / avatar / EMI slip direct upload. Each defaults on;
# 'false' forces the legacy multer path for that surface (direct uploadIds
# rejected with 400); legacy req.files handling always stays available.
BLOG_DIRECT_UPLOAD_ENABLED=
AVATAR_DIRECT_UPLOAD_ENABLED=
EMI_DIRECT_UPLOAD_ENABLED=

# EMI due/overdue reminder cron - set to 'false' to disable
EMI_REMINDERS_ENABLED=

# Data lifecycle jobs (cold-storage archival + retention hard-delete) - set to 'false' to disable both
DATA_LIFECYCLE_JOBS_ENABLED=
# Cold storage thresholds (days)
PROPERTY_COLD_STORAGE_AFTER_DAYS=
SALE_ARCHIVE_AFTER_DAYS=
EMI_PLAN_ARCHIVE_AFTER_DAYS=
# Hard-delete retention windows (days)
CONTACT_FORM_RETENTION_DAYS=
CONVERSATION_RETENTION_DAYS=